# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Local
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas or local
MONGODB_URI=mongodb://127.0.0.1:27017/codeshield

# Email OTP (SMTP) — required for real email delivery in production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="CodeShield AI <noreply@codeshield.ai>"

# Without SMTP_* in development, OTP codes are printed to the server console.

# Verbose server logs (dev default ON). Set false to silence.
# DEBUG_LOGS=false
# Pretty-print API/server-action response bodies in debug logs (dev default ON).
# DEBUG_API_BODY=false
# Include error stacks in [ERROR] logs (default ON in debug).
# DEBUG_STACK=false

# --- Isolated code runner (Phase 5) ---
# NEVER execute student code inside Next.js / Vercel.
# Default: Judge0. Alternative: self-hosted Piston.
CODE_RUNNER_PROVIDER=judge0
JUDGE0_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
# JUDGE0_AUTH_HEADER=X-Auth-Token
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Self-hosted Piston (see docker-compose.code-runner.yml + docs/CODE_RUNNER.md)
# CODE_RUNNER_PROVIDER=piston
# PISTON_URL=http://localhost:2000
# PISTON_API_KEY=

# --- Vercel Production ---
# AUTH_SECRET, MONGODB_URI, AUTH_URL, NEXTAUTH_URL, SMTP_*, EMAIL_FROM
# Plus CODE_RUNNER_* / JUDGE0_* (or a privately reachable Piston URL)
