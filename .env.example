# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Local
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas or local
MONGODB_URI=mongodb://127.0.0.1:27017/codeshield

# Verbose server logs (dev default ON). Set false to silence; true to force on in prod-like runs.
# DEBUG_LOGS=false

# --- Vercel Production (Project → Settings → Environment Variables) ---
# Required:
#   AUTH_SECRET=<same long random string>
#   MONGODB_URI=<your Atlas connection string>
# Recommended:
#   AUTH_URL=https://codeshield-zeta.vercel.app
#   NEXTAUTH_URL=https://codeshield-zeta.vercel.app
# Optional:
#   DEBUG_LOGS=false
#
# After adding env vars → Redeploy.
# Atlas → Network Access → allow 0.0.0.0/0 (or Vercel IPs) so serverless can connect.
