# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Local
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas or local
MONGODB_URI=mongodb://127.0.0.1:27017/codeshield

# MONGODB_URI=mongodb://SyedHassan:Hassan%40123@ac-wb1abqc-shard-00-00.bou4cjm.mongodb.net:27017,ac-wb1abqc-shard-00-01.bou4cjm.mongodb.net:27017,ac-wb1abqc-shard-00-02.bou4cjm.mongodb.net:27017/shield_ace_proctor?ssl=true&replicaSet=atlas-s2t38s-shard-0&authSource=admin&retryWrites=true&w=majority



# Email OTP (SMTP) — required for real email delivery in production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="CodeShield AI <noreply@codeshield.ai>"

# Without SMTP_* in development, OTP codes are printed to the server console.

# Verbose server logs (dev default ON). Set false to silence.
# DEBUG_LOGS=false
# Pretty-print actual server-action/API response JSON (dev default ON when DEBUG_LOGS on).
# DEBUG_API_BODY=true
# Include error stacks in [ERROR] logs (default ON in debug).
# DEBUG_STACK=false

# --- Isolated code runner (Phase 5) ---
# NEVER execute student code inside Next.js / Vercel.
# Default: Judge0. Alternative: self-hosted Piston.
CODE_RUNNER_PROVIDER=judge0
JUDGE0_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
# JUDGE0_AUTH_HEADER=X-Auth-Token
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Self-hosted Piston (see docker-compose.code-runner.yml + docs/CODE_RUNNER.md)
# CODE_RUNNER_PROVIDER=piston
# PISTON_URL=http://localhost:2000
# PISTON_API_KEY=

# --- Vercel Production ---
# AUTH_SECRET, MONGODB_URI, AUTH_URL, NEXTAUTH_URL, SMTP_*, EMAIL_FROM
# Plus CODE_RUNNER_* / JUDGE0_* (or a privately reachable Piston URL)

# --- Exam recording storage (Phase 7) ---
# local (default): writes under .data/recordings and streams via admin auth route
# s3: S3/R2-compatible object storage (required for production recordings)
STORAGE_PROVIDER=local
# RECORDINGS_DIR=.data/recordings

# S3 / Cloudflare R2 (when STORAGE_PROVIDER=s3)
# S3_BUCKET=your-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Browser→S3 direct exam uploads require bucket CORS allowing PUT from your app origin
# with AllowedHeaders including Content-Type (and Authorization if used by the endpoint).
# Example CORS rule: AllowedMethods PUT/GET/HEAD, AllowedOrigins https://your-domain, MaxAge 3000

# --- LiveKit video interviews (Phase 15) ---
# Hosted LiveKit Cloud or self-hosted LiveKit server WebSocket URL.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Secrets stay server-side only — never expose via NEXT_PUBLIC_*.

# --- Certificate issuance (Phase 16) ---
# Global fallback pass % used when an Assessment has no passThreshold override.
# CERTIFICATE_DEFAULT_PASS_THRESHOLD=60

# Demo quick-login on the landing page.
# Off in production unless explicitly set to true.
# ALLOW_DEMO_LOGIN=true

# --- AI subjective grading assist (Phase 25) ---
# Server-only. Never set NEXT_PUBLIC_* on these. Do not commit a real key.
# Manual Save grade still works when this is unset.
# AI_GRADING_API_KEY=
# AI_GRADING_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base (default https://api.openai.com)
# AI_GRADING_BASE_URL=

